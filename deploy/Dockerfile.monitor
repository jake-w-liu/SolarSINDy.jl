# Space-Weather forecast DAEMON container image (the process that issues + locks forecasts).
# Build from the package root:
#   docker build -t swmonitor-daemon -f deploy/Dockerfile.monitor .
# Prefer deploy/docker-compose.yml, which runs this daemon and the dashboard as a supervised pair.
FROM julia:1.12.7-bookworm
ENV JULIA_DEPOT_PATH=/opt/julia-depot JULIA_NUM_PRECOMPILE_TASKS=2

# Shared non-root uid with the dashboard image so the daemon-written log (mode 600) is readable by
# the dashboard over the shared volume.
RUN useradd --create-home --uid 10001 swm
WORKDIR /pkg

# A named Julia package needs its source during precompilation.
COPY Project.toml Manifest.toml ./
COPY src ./src
RUN julia --project=. -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'

# Everything the daemon includes at runtime: the package source, the live-verification engine and
# snapshot collector (examples/), the bundled calibration (deploy/), and the shared forecast API that
# live_monitor.jl includes from app/src.
COPY examples ./examples
COPY deploy ./deploy
COPY app/src ./app/src
COPY data ./data
COPY validation/operational/v2_4_live_claim_audit.jl ./validation/operational/

RUN mkdir -p /data && chown -R swm:swm /pkg /data /opt/julia-depot
VOLUME ["/data"]
ENV SOLARSINDY_MONITOR_DIR=/data JULIA_NUM_THREADS=2
USER swm
# Liveness = the daemon is still issuing: fail if the locked-live log has not been rewritten within
# two hourly cadences, so a stuck/dead daemon is restarted by the orchestrator.
HEALTHCHECK --interval=120s --timeout=10s --start-period=300s --retries=3 \
  CMD test "$(( $(date -u +%s) - $(stat -c %Y /data/live_forecast_log.csv 2>/dev/null || echo 0) ))" -lt 7200 || exit 1
CMD ["julia", "--project=.", "examples/live_monitor.jl"]
