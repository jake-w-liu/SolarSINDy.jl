<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template for the SolarSINDy live Dst forecast monitor (macOS).

  Prefer the install script, which fills these placeholders and creates the log directory:
    deploy/install_launchd.sh <CLONE_DIR>
  Manual install: replace every __PLACEHOLDER__ with an absolute path, create
  __MONITOR_DIR__/logs, copy to ~/Library/LaunchAgents/, then bootstrap with:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.solarsindy.live-monitor.plist

    __JULIA_BIN__     absolute path to the julia launcher. Use the STABLE juliaup shim
                      (~/.juliaup/bin/julia), NOT a version-pinned juliaup directory such as
                      ~/.julia/juliaup/julia-1.12.6+0.../bin/julia — `juliaup gc`/`juliaup update`
                      deletes version directories and would leave a silent 60 s crash loop.
    __CLONE_DIR__     absolute path to the SolarSINDy.jl clone (the --project environment)
    __MONITOR_DIR__   output/state directory (default __CLONE_DIR__/var/monitor)

  Console streams go to bounded, self-rotating files under __MONITOR_DIR__/logs (launchd does not
  rotate them, so the daemon rotates launchd.out/launchd.err once per (re)start and mirrors its full
  diagnostic history into the size-capped monitor.log ring). This keeps forensic output for a crash
  or unload instead of discarding it to /dev/null.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.solarsindy.live-monitor</string>

  <key>ProgramArguments</key>
  <array>
    <string>__JULIA_BIN__</string>
    <string>--project=__CLONE_DIR__</string>
    <string>__CLONE_DIR__/examples/live_monitor.jl</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__CLONE_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SOLARSINDY_MONITOR_DIR</key>
    <string>__MONITOR_DIR__</string>
    <key>JULIA_NUM_THREADS</key>
    <string>2</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__MONITOR_DIR__/logs/launchd.out</string>

  <key>StandardErrorPath</key>
  <string>__MONITOR_DIR__/logs/launchd.err</string>
</dict>
</plist>
